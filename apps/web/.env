# App Config
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Realtime. Without these the socket client falls back to http://localhost:3000,
# where nothing listens, and retries forever — flooding the console with
# ERR_CONNECTION_REFUSED on every page.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
QDRANT_URL=
QDRANT_API_KEY=


OPENAI_API_KEY=