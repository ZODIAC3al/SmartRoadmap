{
  "name": "smartroadmap",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.2.5",
    "turbo": "^2.10.5"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^3.1.0",
    "web-push": "^3.6.7"
  }
}
